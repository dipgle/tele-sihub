{
  "db": "data/huba.sqlite",
  "log_file": "logs/huba.log",
  "project_roots": [
    "",
    "AI"
  ],
  "poll_interval_sec": 120,
  "call": {
    "max_budget_usd": 0.5,
    "timeout_sec": 240
  },
  "auto_handover": {
    "enabled": true,
    "at_percent": 60,
    "idle_sec": 120,
    "on_limit": true,
    "on_limit_wait_min": 30
  },
  "auto_run": {
    "enabled": true
  },
  "auto_unstick": {
    "enabled": false
  },
  "confirm": {
    "enabled": true,
    "bot_token_env": "HUB_TELEGRAM_BOT_TOKEN",
    "chat_id_env": "HUB_TELEGRAM_CHAT_ID",
    "timeout_sec": 90,
    "delete_after_hours": 36
  },
  "projects": {
    "ai1": {},
    "codetrail": {},
    "dwork": {},
    "sdvi": {},
    "social": {},
    "tafalo5": {},
    "tcc": {},
    "tfl5": {}
  },
  "notify": {
    "file": "logs/notify.log",
    "macos_notification": true
  },
  "claude_cli": "claude",
  "opencode_cli": "$HOME/.opencode/bin/opencode",
  "claude_accounts": [
    {
      "name": "acc1",
      "launch": "claude",
      "locked": true
    },
    {
      "name": "acc2",
      "config_dir": "~/.claude-acc2",
      "launch": "claude2",
      "locked": true
    },
    {
      "name": "acc3",
      "config_dir": "~/.claude-acc3",
      "launch": "claude3",
      "locked": true
    },
    {
      "name": "acc4",
      "config_dir": "~/.claude-acc4",
      "locked": true
    },
    {
      "name": "acc5",
      "config_dir": "~/.claude-acc5",
      "locked": true
    },
    {
      "name": "acc6",
      "config_dir": "~/.claude-acc6",
      "locked": true
    },
    {
      "name": "acc7",
      "config_dir": "~/.claude-acc7",
      "locked": true
    },
    {
      "name": "acc8",
      "config_dir": "~/.claude-acc8",
      "env_file": "~/.opencode_acc8.env",
      "api_key_env": "OPENCODE_API_KEY",
      "model": "opencode-go/deepseek-v4.1-flash",
      "cli": "opencode",
      "opencode_config": {
        "mcp": {
          "project-agent": {
            "command": [
              "~/projects/AI/codetrail/mcp/project-agent-rs/target/release/project-agent"
            ],
            "environment": {
              "PROJECTS_ROOT": "~/projects"
            },
            "type": "local"
          }
        },
        "plugin": [
          "~/projects/scripts/cong-bao-mat-plugin"
        ]
      }
    },
    {
      "name": "acc9",
      "config_dir": "~/.claude-acc9",
      "launch": "env $(cat $HOME/.opencode_acc9.env | xargs) CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4.1-flash CLAUDE_CONFIG_DIR=$HOME/.claude-acc9 claude --debug --model deepseek-v4.1-flash",
      "locked": true
    },
    {
      "name": "acc10",
      "config_dir": "~/.codex-acc10",
      "cli": "codex"
    }
  ],
  "new_in_terminal": true,
  "sudo_password_env": {
    "vps-a": "HUB_VPS_A_SUDO_PASSWORD"
  },
  "pin_following": true
}
